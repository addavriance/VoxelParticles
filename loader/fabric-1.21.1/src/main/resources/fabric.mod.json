{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "addavriance",
    "chelovek_exe"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/voxelparticles",
    "sources": "https://github.com/addavriance/VoxelParticles",
    "issues": "https://github.com/addavriance/VoxelParticles/issues"
  },

  "license": "${mod_license}",
  "icon": "assets/voxelparticles/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "me.adda.voxelparticles.fabric.VoxelParticlesClient"
    ],
    "modmenu": [
      "me.adda.voxelparticles.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "voxelparticles.mixins.json"
  ],

  "depends": {
    "fabricloader": "${loader_range}",
    "fabric": "*",
    "minecraft": "${fabric_mc_range}"
  }
}
